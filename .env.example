OPENAI_API_KEY=
DATABASE_URL=postgresql+psycopg://cb:cb@db:5432/cb
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage. Points at MinIO locally/CI; swap to real S3
# in prod by changing S3_ENDPOINT_URL (or leaving it blank) and credentials.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=codebench
S3_REGION=us-east-1
